# /opt/publicnat/env.sh — единый источник секретов и путей.
# Файл читается systemd-юнитом (EnvironmentFile) и скриптами deploy.sh / rathole.env.sh.
# Права: chmod 600, владелец root.

# --- PostgreSQL (подключение по TCP localhost, scram-sha-256) ---
PG_DB=publicnat
PG_USER=publicnat
PG_PASSWORD=CHANGE_ME_strong_db_password
# ВНИМАНИЕ: пароль внутри DATABASE_URL обязан совпадать с PG_PASSWORD выше!
DATABASE_URL=postgres://publicnat:CHANGE_ME_strong_db_password@localhost:5432/publicnat?sslmode=disable

# --- JWT ---
# Сгенерируйте: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_TTL_HOURS=24

# --- HTTP API ---
API_ADDR=:8080

# --- RatHole control plane ---
RATHOLE_CONFIG_PATH=/etc/rathole/server.toml
RATHOLE_BIND_ADDR=0.0.0.0:2333
# SIGHUP отправляется напрямую процессу (PID файла юнита rathole.service), Docker не используется:
RATHOLE_PIDFILE=/run/rathole.pid

# --- Диапазон портов для автоматической выдачи туннелям ---
PORT_RANGE_START=5000
PORT_RANGE_END=6000
SYSTEM_PORT_CHECK=true

# --- Версия бинарника RatHole (server) ---
RATHOLE_VERSION=v0.5.9
