# PostgreSQL
DATABASE_URL=postgres://rathole:rathole@localhost:5543/rathole?sslmode=disable
MIGRATIONS_DIR=./migrations

# HTTP API
API_ADDR=:8080
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24

# RatHole control plane
RATHOLE_CONFIG_PATH=/etc/rathole/server.toml
RATHOLE_CONTAINER=rathole-server
RATHOLE_BIND_ADDR=0.0.0.0:2333
# Если RatHole работает без Docker на той же машине — укажите его PID и
# SIGHUP будет отправлен напрямую через syscall.Kill (Docker не нужен):
# RATHOLE_PID=12345

# Диапазон портов для автоматической выдачи туннелям
PORT_RANGE_START=5000
PORT_RANGE_END=6000

# Проверять физическую занятость порта на хосте перед выдачей (true/false)
SYSTEM_PORT_CHECK=true
